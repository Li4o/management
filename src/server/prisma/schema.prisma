// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Item table
model Item {
  id            String      @id @default(uuid())
  classId       String
  assetTag      String?     @unique
  name          String
  category      String
  status        AssetStatus @default(AVAILABLE)
  location      String
  customFields  Json?  
  description   String?
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  Logs     AssetLog[]

  class Class     @relation(fields: [classId], references: [id])
  users Users     @relation(fields: [createdBy], references: [id])

  @@map("items")
}

// Asset Logs
model AssetLog {
  id          String      @id @default(uuid())
  itemId      String
  action      ActionType
  reason      String
  createdBy   String
  createdAt   DateTime    @default(now())

  item  Item        @relation(fields: [itemId], references: [id])
  users Users       @relation(fields: [createdBy], references: [id])

  @@map("assetLogs")
}

// User
model Users {
  id            String      @id @default(uuid())
  name          String      @unique
  email         String?
  passwordHash  String
  createdAt     DateTime    @default(now())

  Logs    AssetLog[]
  Field   CustomFields[]
  Class   Class[]
  Item    Item[]

  @@map("users")
}

// Custom Field
model CustomFields {
  id        String        @id @default(uuid())
  classId   String
  name      String
  type      FieldType
  options   Json
  createdBy String
  createdAt DateTime      @default(now())

  class Class       @relation(fields: [classId], references: [id])
  users Users       @relation(fields: [createdBy], references: [id])

  @@map("customField")
}

// Class
model Class {
  id          String        @id @default(uuid())
  name        String
  description String?
  createdBy   String
  createdAt   DateTime      @default(now())

  users Users       @relation(fields: [createdBy], references: [id])

  Item        Item[]
  customField CustomFields[]

  @@map("classes")
}

// Asset Status
enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  DISPOSED
}

// Action Type
enum ActionType {
  CHECK_OUT
  CHECK_IN
  MAINTENANCE
  DISPOSED
}

// Field Type
enum FieldType {
  TEXT
  SELECT
}